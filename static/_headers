# Wheel of Heaven - Caching Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Fonts - immutable, cache for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS - cache for 1 week with stale-while-revalidate
/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# JavaScript - cache for 1 week with stale-while-revalidate
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Brand assets - cache for 1 month
/brand/*
  Cache-Control: public, max-age=2592000

# Icons - cache for 1 month
/icons/*
  Cache-Control: public, max-age=2592000

# Static images - cache for 1 week
/images/*
  Cache-Control: public, max-age=604800

# Map tiles - cache for 1 month
/map/*
  Cache-Control: public, max-age=2592000

# Starmap SVG - cache for 1 month (large file, rarely changes)
/starmap.svg
  Cache-Control: public, max-age=2592000

# Service worker - no cache (needs fresh checks)
/sw.js
  Cache-Control: no-cache

# Web manifest - cache for 1 day
/site.webmanifest
  Cache-Control: public, max-age=86400

# Agent discovery — see https://docs.wheelofheaven.world/ai-ingestion/agent-discovery/
# These paths are extensionless or non-HTML, so Pages needs the Content-Type
# spelled out. Short max-age: they change rarely but must not go stale for a
# scanner after an edit.

# RFC 9116 security contact. The spec requires text/plain; charset=utf-8,
# and Pages would otherwise serve it without the charset.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# RFC 9727 API catalog (linkset)
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=3600

# Authentication policy (there is none). Also served at /auth.md via a 200
# rewrite in _redirects — headers match the request path, so both need the rule.
/.well-known/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/mcp/*
  Cache-Control: public, max-age=3600

/.well-known/agent-skills/*
  Cache-Control: public, max-age=3600

# Security headers for all pages.
#
# Keep comments OUTSIDE the block and short: indented lines are parsed as
# `name: value`, and a long preamble stopped three headers applying on the
# docs site. See docs contributing/dev/ci-deploy.md.
#
# No HSTS here — it is set zone-wide in Cloudflare (SSL/TLS -> Edge
# Certificates -> HSTS) so every host gets it, not just this one. The edge
# value REPLACES an origin one, so a line here would be silently overridden
# rather than duplicated. Preload is deliberately off.
/*
  Link: </.well-known/api-catalog>; rel="api-catalog"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://assets.wheelofheaven.world data: blob:; font-src 'self'; connect-src 'self' https://assets.wheelofheaven.world https://api.wheelofheaven.world https://mcp.wheelofheaven.world; media-src 'self' https://assets.wheelofheaven.world; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
